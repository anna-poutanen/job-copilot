# ---- Copy this file to ".env" and fill in your own values ----

# REQUIRED for writing (cover letters, outreach). Get one at console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — which model to use. Sensible default below.
LLM_MODEL=claude-sonnet-5

# Your timezone, for the daily agenda (e.g. America/Toronto, America/New_York).
TIMEZONE=America/Toronto

# ---- Email sending (only needed if you want to actually send) ----
# For Gmail: turn on 2FA, then create an "App Password" and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password
FROM_NAME=Anna Poutanen
FROM_EMAIL=your.email@gmail.com

# ---- Safety caps for autosend (leave as-is unless you know what you're doing) ----
MAX_SENDS_PER_RUN=20
SEND_DELAY_SECONDS=4

# ---- Optional job source: Adzuna (free key at developer.adzuna.com) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Company boards to pull intern/co-op postings from (public JSON feeds) ----
# Add or remove company tokens as you like.
GREENHOUSE_BOARDS=shopify,stripe,figma,databricks,affirm,samsara,wealthsimple,faire
LEVER_BOARDS=cohere,ada,plotly,benchsci
